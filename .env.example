# TitanDesk control-plane API the /admin (Super Admin) console talks to.
# Session auth is a cookie set by that server, so this origin must also be
# added to its TITANDESK_ALLOWED_ORIGINS (see TitanNetwork-main/server/.env.example).
# Open this site itself as http://127.0.0.1:5190, not localhost:5190 — the
# session cookie is SameSite=Lax in local dev, and "localhost" vs "127.0.0.1"
# don't count as the same site even though both are loopback, so the wrong
# hostname silently drops the cookie on every /admin API call.
VITE_TITANDESK_API_URL=http://127.0.0.1:4100

# Where the real TitanDesk product app runs — /login and /register send a
# signed-in visitor here after a successful sign-in or workspace creation.
VITE_TITANDESK_WEB_URL=http://127.0.0.1:5173

# Where visitors sign in / sign up. One account covers every Titan Network
# product, so this is not tied to TitanDesk. Leave unset while TitanDesk's app
# hosts the account pages (defaults to VITE_TITANDESK_WEB_URL); point it at a
# shared accounts app (e.g. https://accounts.titannetwork.com) once one exists.
# VITE_ACCOUNT_URL=
